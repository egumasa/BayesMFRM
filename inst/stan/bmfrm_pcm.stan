// Partial Credit Model (PCM) template generated by BayesMFRM
// Facet-specific adjacent-category step deviations
// Threshold facet: {{THRESHOLD_FACET}}

data {
  int<lower=1> N;                // number of observations
  int<lower=2> K;                // number of rating categories
  array[N] int<lower=1, upper=K> X;   // observed ratings

  // {{FACET_DATA_DECL}}
  // {{MODEL_DATA}}
}

transformed data {
  vector[K] cat_seq = linspaced_vector(K, 0.0, K - 1.0);
  vector[K] cat_val = linspaced_vector(K, 1.0, K);
  vector[K] cat_val2 = square(cat_val);
}

parameters {
  // ability facet ({{PERSON_FACET}})
  // {{ABILITY_PARAM_DECL}}

  // {{FACET_PARAM_DECL}}

  // facet-specific step deviations (unordered adjacent-category formulation)
  // {{THRESHOLD_PARAM_DECL}}

  // {{BIAS_PARAM_DECL}}
}

transformed parameters {
  // {{ABILITY_TRANSFORM}}

  // {{FACET_TRANSFORM}}

  // Step deviations sum to zero within each threshold-facet level.
  // {{THRESHOLD_TRANSFORM}}

  // {{BIAS_TRANSFORM}}
}

model {
  // {{PRIOR_BLOCK}}

  // vectorized linear predictor & per-level precomputed cumulative thresholds
  {
    array[J_{{THRESHOLD_FACET}}] vector[K] cum_tau;
    vector[N] eta = theta[{{PERSON_FACET}}_id]
                    // {{ETA_VEC_MAIN}};
    for (j in 1:J_{{THRESHOLD_FACET}}) {
      cum_tau[j] = append_row(0.0, cumulative_sum(tau[j]'));
    }
    // {{ETA_VEC_BIAS}}
    for (n in 1:N) {
      X[n] ~ categorical_logit(cat_seq * eta[n] - cum_tau[{{THRESHOLD_FACET}}_id[n]]);
    }
  }
}

