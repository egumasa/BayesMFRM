// Partial Credit Model (PCM) template generated by BayesMFRM
// Facet-specific thresholds (unordered - standard Rasch)
// Threshold facet: {{THRESHOLD_FACET}}

data {
  int<lower=1> N;                // number of observations
  int<lower=2> K;                // number of rating categories
  array[N] int<lower=1, upper=K> X;   // observed ratings

  // {{FACET_DATA_DECL}}
}

parameters {
  // person abilities (always present)
  vector[J_person] theta_raw;

  // {{FACET_PARAM_DECL}}

  // thresholds (facet-specific, unordered for diagnostic purposes)
  matrix[J_{{THRESHOLD_FACET}}, K-1] tau_raw;

  // {{BIAS_PARAM_DECL}}
}

transformed parameters {
  // person abilities
  vector[J_person] theta;
  theta = theta_raw;

  // {{FACET_TRANSFORM}}

  // thresholds (column-wise sum-to-zero constraint for identification)
  matrix[J_{{THRESHOLD_FACET}}, K - 1] tau;
  for (k in 1:(K-1)) {
    tau[:, k] = tau_raw[:, k] - mean(tau_raw[:, k]);
  }

  // {{BIAS_TRANSFORM}}
}

model {
  // {{PRIOR_BLOCK}}

  // likelihood
  for (n in 1:N) {
    int person_n = person_id[n];
    // {{INDEX_EXTRACT}}
    int threshold_n = {{THRESHOLD_FACET}}_id[n];

    real eta = theta[person_n]
               // {{ETA_SUM}};

    vector[K] logits;
    logits[1] = 0;
    for (k in 2:K) {
      logits[k] = logits[k-1] + eta - tau[threshold_n, k-1];
    }

    X[n] ~ categorical_logit(logits);
  }
}

generated quantities {
  vector[N] log_lik;
  array[N] int<lower=1, upper=K> y_rep;
  vector[N] mu;        // expected score E[Y_n] under actual facets
  vector[N] sigma2;    // model variance Var(Y_n) under actual facets
  vector[N] mu_fair;   // expected score with "fair" facets

  for (n in 1:N) {
    int person_n = person_id[n];
    // {{INDEX_EXTRACT}}
    int threshold_n = {{THRESHOLD_FACET}}_id[n];

    // ---- 1) Actual facets ----
    real eta_full = theta[person_n]
                    // {{ETA_SUM}};
    real eta_fair = theta[person_n]
                    // {{ETA_SUM_FAIR}};

    vector[K] logits_full;
    vector[K] logits_fair;
    vector[K] p_full;
    vector[K] p_fair;
    real ex;
    real ex2;
    real ex_fair;

    // build logits for partial-credit model (facet-specific thresholds)
    logits_full[1] = 0;
    logits_fair[1] = 0;
    for (k in 2:K) {
      logits_full[k] = logits_full[k-1] + eta_full - tau[threshold_n, k-1];
      logits_fair[k] = logits_fair[k-1] + eta_fair - tau[threshold_n, k-1];
    }

    // probabilities
    p_full = softmax(logits_full);
    p_fair = softmax(logits_fair);

    // expected scores and variance on 1..K scale
    ex = 0;
    ex2 = 0;
    ex_fair = 0;
    for (k in 1:K) {
      ex  += k * p_full[k];
      ex2 += k * k * p_full[k];
      ex_fair += k * p_fair[k];
    }
    mu[n]      = ex;
    sigma2[n]  = ex2 - ex * ex;
    mu_fair[n] = ex_fair;

    // log-likelihood & posterior predictive
    log_lik[n] = categorical_logit_lpmf(X[n] | logits_full);
    y_rep[n]   = categorical_logit_rng(logits_full);
  }
}
