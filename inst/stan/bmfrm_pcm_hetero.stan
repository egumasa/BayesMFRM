// Heterogeneous-Category Partial Credit Model (PCM) template generated by BayesMFRM
// Level-specific category counts K_level[j] >= 2 with packed ragged step vector tau.
// Threshold facet: {{THRESHOLD_FACET}}

data {
  int<lower=1> N;                        // number of observations
  int<lower=2> K_max;                    // maximum category count across levels
  array[N] int<lower=1, upper=K_max> X;  // observed ratings (validated 1..K_level[j] in R)

  // {{FACET_DATA_DECL}}

  array[J_{{THRESHOLD_FACET}}] int<lower=2, upper=K_max> K_level;
  int<lower=1> N_tau_steps;
  array[J_{{THRESHOLD_FACET}}] int<lower=1, upper=N_tau_steps> tau_start;
  array[J_{{THRESHOLD_FACET}}] int<lower=1> tau_len;

  // {{MODEL_DATA}}
}

transformed data {
  vector[K_max] cat_seq = linspaced_vector(K_max, 0.0, K_max - 1.0);
  vector[K_max] cat_val = linspaced_vector(K_max, 1.0, K_max);
  vector[K_max] cat_val2 = square(cat_val);
}

parameters {
  // ability facet ({{PERSON_FACET}})
  // {{ABILITY_PARAM_DECL}}

  // {{FACET_PARAM_DECL}}

  // ragged facet-specific step deviations (zero free parameters for K_level[j] == 2)
  // {{THRESHOLD_PARAM_DECL}}

  // {{BIAS_PARAM_DECL}}
}

transformed parameters {
  // {{ABILITY_TRANSFORM}}

  // {{FACET_TRANSFORM}}

  // Step deviations sum to zero within each threshold-facet level (0 for K_level[j] == 2).
  // {{THRESHOLD_TRANSFORM}}

  // {{BIAS_TRANSFORM}}
}

model {
  // {{PRIOR_BLOCK}}

  // vectorized linear predictor & per-level precomputed cumulative ragged steps
  {
    vector[N_tau_steps] cum_tau;
    vector[N] eta = theta[{{PERSON_FACET}}_id]
                    // {{ETA_VEC_MAIN}};
    for (j in 1:J_{{THRESHOLD_FACET}}) {
      int s = tau_start[j];
      int mj = tau_len[j];
      cum_tau[s:(s + mj - 1)] = cumulative_sum(tau[s:(s + mj - 1)]);
    }
    // {{ETA_VEC_BIAS}}
    for (n in 1:N) {
      int threshold_n = {{THRESHOLD_FACET}}_id[n];
      int Kj = K_level[threshold_n];
      int t_start = tau_start[threshold_n];
      vector[Kj] logits = head(cat_seq, Kj) * eta[n];
      logits[2:Kj] -= cum_tau[t_start:(t_start + Kj - 2)];
      X[n] ~ categorical_logit(logits);
    }
  }
}

// {{GQ_BLOCK}}
