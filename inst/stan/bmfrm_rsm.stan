model {
  // {{PRIOR_BLOCK}}

  // vectorized linear predictor & precomputed cumulative thresholds
  {
    vector[K] cum_tau = append_row(0.0, cumulative_sum(tau));
    vector[N] eta = theta[{{PERSON_FACET}}_id]
                    // {{ETA_VEC_MAIN}};
    // {{ETA_VEC_BIAS}}
    for (n in 1:N) {
      X[n] ~ categorical_logit(cat_seq * eta[n] - cum_tau);
    }
  }
}

